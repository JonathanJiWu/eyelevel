{
  "expo": {
    "name": "eyelevel",
    "slug": "eyelevel",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "eyelevel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.eyelevel"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.anonymous.eyelevel"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "eyelevel",
      "shortName": "eyelevel",
      "description": "Discover movies, build watchlists, and see what your friends want to watch.",
      "themeColor": "#121212",
      "backgroundColor": "#121212"
    },
    "plugins": [
      [
        "expo-router",
        {
          "apiRoutes": true,
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
