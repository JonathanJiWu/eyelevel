{
  "name": "eyelevel",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export -p web && node server/csp.js --write dist",
    "serve": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --selectProjects unit",
    "test:rules": "npx --yes firebase-tools@15.37.0 emulators:exec --only firestore --project demo-eyelevel \"jest --selectProjects rules --runInBand\"",
    "emulators": "npx --yes firebase-tools@15.37.0 emulators:start --only auth,firestore --project demo-eyelevel",
    "mock:tmdb": "node scripts/mock-tmdb.js",
    "test:e2e": "node scripts/run-e2e.js",
    "deploy:firestore": "npx --yes firebase-tools@15.37.0 deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "compression": "^1.8.1",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-server": "~58.1.0",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "express": "^4.22.3",
    "firebase": "^11.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.63.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
