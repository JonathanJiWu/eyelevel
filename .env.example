# Copy to `.env.local` for local development (it is git-ignored), or set these
# in your hosting provider's environment settings. Never commit real values.

# ---------------------------------------------------------------------------
# Server-only secrets (read by /api routes at runtime; NEVER sent to browsers)
# ---------------------------------------------------------------------------
# TMDB credential — set ONE of these (https://www.themoviedb.org/settings/api).
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Optional overrides
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# TMDB_LANGUAGE=en-US
# TMDB_TIMEOUT_MS=8000
# API_RATE_LIMIT_BURST=120
# API_RATE_LIMIT_PER_SECOND=4

# ---------------------------------------------------------------------------
# Public client configuration (inlined into the app bundle at BUILD time)
# ---------------------------------------------------------------------------
# Firebase web app config: Firebase console → Project settings → General →
# Your apps → Web app → SDK setup and configuration. These identify the
# project and are safe to ship to browsers; access is enforced by
# firestore.rules. Restrict the API key to your domains in Google Cloud.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=eyelevel-2025.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=eyelevel-2025
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=eyelevel-2025.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: show "Continue with Google" on the web (enable the Google provider
# in Firebase Auth and add your domain to Authorized domains first).
# EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN=true

# Native (iOS/Android) builds only: the deployed site that serves /api.
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.example

# ---------------------------------------------------------------------------
# Local development against the Firebase emulators (npm run emulators)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-eyelevel
# Use the mock TMDB API instead of the real one (npm run mock:tmdb):
# TMDB_API_BASE_URL=http://127.0.0.1:4010/3
# TMDB_API_KEY=test-key
# EXPO_PUBLIC_TMDB_IMAGE_BASE_URL=http://127.0.0.1:4010/img
